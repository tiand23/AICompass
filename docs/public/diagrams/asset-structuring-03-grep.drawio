        <mxCell id="links_declared" value="&lt;b&gt;关系 · 明记&lt;/b&gt;&lt;font style=&quot;font-size:10px&quot; color=#3E6B63&gt;（source=declared）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;参照テーブルID / 参照フィールドID 列写明的&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
