        <!-- ============ ③ 向量索引（embed.py，可选） ============ -->
        <mxCell id="vecbox" value="&lt;b&gt;③ 向量索引&lt;/b&gt;（embed.py）&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#9C3B2C&gt;可选 · 非必需&lt;/font&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;：只是 search_docs 的语义相近打分辅助信号，&lt;b&gt;没有它系统一样能完整工作&lt;/b&gt;（纯全文检索）。build.py 支持 --no-embed 直接跳过。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;产出：vectors.sqlite&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFFFFF;strokeColor=#8A8F96;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=16;spacingTop=16;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
