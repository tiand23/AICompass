        <mxCell id="leg5" value="" style="rounded=1;arcSize=4;dashed=1;html=1;fillColor=#FFFFFF;strokeColor=#8A8F96;strokeWidth=1.4;" vertex="1" parent="legend">
          <mxGeometry x="10" y="184" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg5t" value="可选组件（向量索引，非必需，虚线框）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="180" width="235" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg6" value="" style="html=1;endArrow=open;endFill=0;strokeWidth=1.2;strokeColor=#9C3B2C;dashed=1;" edge="1" parent="legend">
          <mxGeometry width="30" height="18" relative="1" as="geometry">
            <mxPoint x="10" y="216" as="sourcePoint" />
            <mxPoint x="40" y="216" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg6t" value="回环 / 跨区引用（报告→调 config→重跑；台账+索引→Agent）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="206" width="235" height="34" as="geometry" />
        </mxCell>
        <mxCell id="leg7" value="示例" style="text;html=1;align=center;verticalAlign=middle;fontSize=10.5;fontColor=#9C3B2C;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="10" y="250" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg7t" value="小号赤陶红文字 = 需要人工确认 / 置信度标注" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="246" width="235" height="34" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
