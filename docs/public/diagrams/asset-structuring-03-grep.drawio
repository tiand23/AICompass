          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="get_result" value="&lt;b&gt;拿到结果&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;纯 SQL / 规则返回的 JSON——这一步没有 LLM 参与，kbtools.py 不含任何 AI 逻辑&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="2476" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e_call_result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" edge="1" parent="1" source="call_tool" target="get_result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_result_loop" value="循环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#8A6A2E;fontColor=#8A6A2E;fontSize=10;endArrow=open;endFill=0;exitX=0;exitY=0.15;entryX=0;entryY=0.75;" edge="1" parent="1" source="get_result" target="llm_judge">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="2490" />
              <mxPoint x="120" y="2444" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="final_answer" value="&lt;b&gt;生成最终回答&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;附出典；标注哪些设计书明写、哪些是推断、哪些没查到写「未确认」&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="190" y="2510" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_final" value="够了 / 到预算上限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;fontColor=#5B6169;fontSize=10;endArrow=open;endFill=0;" edge="1" parent="1" source="llm_judge" target="final_answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="budget_note" value="&lt;b&gt;预算保护&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;最多循环 12 轮／调用 24 次工具。快到上限时，系统提示 LLM「这是最后机会，只能用已有材料回答，查不到的地方必须写未确认」——不会无限查下去。&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F96;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=11;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="2476" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_call_budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1;strokeColor=#8A8F96;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="call_tool" target="budget_note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_summary_agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.4;strokeColor=#1B2229;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="summary_kb" target="q_input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="grp_find" value="&lt;b&gt;找（第一手）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;grep&lt;/b&gt;：原文全量机械检索，不排序不截断（默认限60条但告知总数）。&lt;b&gt;探索的第一手，地位最突出&lt;/b&gt;。结果带 in_column（该词在哪个表头列下——判断定义/引用）和 next_terms（同行其它标识符，供继续深挖）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;list_objects&lt;/b&gt;：全体目录（表/画面/程序/72行sheet目录）——不知道去哪找，看目录比检索更快更准&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="100" y="2680" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_find" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="112" y="2704" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="grp_confirm" value="&lt;b&gt;确认&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;impact_of&lt;/b&gt;：多跳影响范围（区分 declared/inferred），并自动兜底 grep 全文，把台账没收录的 other_mentions 也列出来，防止台账覆盖不全漏查&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;get_table / get_screen&lt;/b&gt;：拿某表/某画面完整定义&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;read_around&lt;/b&gt;：读 grep 命中处上下文（大表专用）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;get_sheet&lt;/b&gt;：读某 sheet 完整原文（给出处用）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26415C;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="2680" width="460" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_confirm" value="" style="shape=mxgraph.ios7.icons.documents;html=1;strokeColor=#26415C;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="2704" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="grp_assist" value="&lt;b&gt;辅助&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;resolve&lt;/b&gt;：日语人话→物理名翻译，&lt;font color=#9C3B2C&gt;查不到就返回相似候选 + 原文 grep 结果，绝不瞎猜&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;find_entity&lt;/b&gt;：某名字在哪定义/出现（台账+全文双查）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;search_docs&lt;/b&gt;：语义检索，&lt;b&gt;只在 grep 和 list_objects 都找不到时才用&lt;/b&gt;，全文 BM25 为主，向量（如果有）只是加分辅助&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1080" y="2680" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_assist" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#8A6A2E;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1092" y="2704" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_agent_find" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=0.34;entryY=0;" edge="1" parent="1" source="call_tool" target="grp_find">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="2411" />
              <mxPoint x="560" y="2650" />
              <mxPoint x="250" y="2650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_agent_confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call_tool" target="grp_confirm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_agent_assist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.85;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="call_tool" target="grp_assist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="synth" value="&lt;b&gt;真实的兜底关系&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px&quot; color=#5B6169&gt;grep（全文机械检索）本身直接查原文，不经过台账，是绕开台账覆盖不全的兜底手段；impact_of 等台账类工具反而会主动调用 grep 补漏。真实设计不是「台账为主、向量为辅」，而是&lt;b&gt;「grep + 台账互为兜底，语义检索是最后手段」&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=44;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="2970" width="1320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ic_synth" value="" style="shape=mxgraph.ios7.icons.flag;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="218" y="3008" width="24" height="24" as="geometry" />
        </mxCell>

        <mxCell id="e_find_synth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.4;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="grp_find" target="synth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_confirm_synth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grp_confirm" target="synth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_assist_synth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.6;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="grp_assist" target="synth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="final" value="&lt;b&gt;问答就绪&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;serve.py 提供网页界面，SSE 流式展示 agent 每一步调用了哪个工具、命中了几条——让用户看到调查过程，而不是干等&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=14;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="3110" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_final" value="" style="shape=mxgraph.ios7.icons.pie_chart;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="612" y="3143" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="e_synth_final" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" edge="1" parent="1" source="synth" target="final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_finalanswer_final" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.3;strokeColor=#1B2229;endArrow=open;endFill=0;exitX=0;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="final_answer" target="final">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="50" y="2610" />
              <mxPoint x="50" y="3155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6D3C8;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1750" y="60" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;" vertex="1" parent="legend">
          <mxGeometry x="10" y="30" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="通用处理步骤" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="27" width="230" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.8;" vertex="1" parent="legend">
          <mxGeometry x="10" y="58" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="机械抽取 / 高确定性（路径A、表型抽取器、grep、list_objects 等）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="54" width="235" height="34" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;" vertex="1" parent="legend">
          <mxGeometry x="10" y="100" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg3t" value="AI 处理 / 需要判断（索引摘要路径B、resolve 候选等）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="96" width="235" height="34" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=1;arcSize=4;html=1;fillColor=#FDF3F0;strokeColor=#9C3B2C;strokeWidth=1.8;" vertex="1" parent="legend">
          <mxGeometry x="10" y="142" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="leg4t" value="需要人工确认（REVIEW.md、corrections、KB_REPORT.md，全图唯一强调色）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="136" width="235" height="34" as="geometry" />
