<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="资产结构化-方案三-以grep为中心">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="资产结构化 · 方案三：以 grep 为中心（工程1→2→3 真实实现）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1100" height="32" as="geometry" />
        </mxCell>

        <!-- ===================== PHILOSOPHY CALLOUT ===================== -->
        <mxCell id="ph1" value="&lt;b&gt;精度来自工具，不来自 AI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;机械抽取优先：能靠规则 / 列位置 / 语法树抽取的内容一律不问 AI（0 费用 · 100% 准确 · 可复现）；AI 只处理机械做不到的事——读图、读散文、写摘要。表格类内容绝不交给 AI 抄：实测同一张表 AI 有时抄 26 个字段有时只抄 2 个，机械抄永远是 26 个。&lt;br&gt;台账构建（下面②）完全是&lt;b&gt;规则驱动&lt;/b&gt;（config 里的 extractor 定义），不掺杂 LLM；AI 只出现在「索引摘要」（下面①）这一步，做它擅长的事。&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=44;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1650" height="112" as="geometry" />
        </mxCell>
        <mxCell id="ic_ph1" value="" style="shape=mxgraph.ios7.icons.flag;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="58" y="106" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ===================== INPUT ===================== -->
        <mxCell id="in1" value="&lt;b&gt;原始资产&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;Excel 设计书（工程1 ExcelSheetToPngText 的输入）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="204" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ic_in1" value="" style="shape=mxgraph.ios7.icons.documents;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="692" y="227" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="e_in_doclane" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.34;entryY=0;" edge="1" parent="1" source="in1" target="doclane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== DOC LANE (工程1 + 工程2：索引 + 台账) ===================== -->
        <mxCell id="doclane" value="ExcelSheetToPngText（工程1）→ DesignDocIndexer（工程2 索引 + 工程3 台账，build.py 统一调度）" style="swimlane;startSize=32;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E6E7A;fontSize=14;fontStyle=1;verticalAlign=top;fontColor=#2E6E7A;strokeWidth=1.6;fontFamily=Helvetica;swimlaneFillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1650" height="1860" as="geometry" />
        </mxCell>

        <mxCell id="d_sub1" value="区块 1 · 机械转换（ExcelSheetToPngText）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#2E6E7A;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="44" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="d1a" value="&lt;b&gt;直接读 Excel 内部文件&lt;/b&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;（不走常规读取方式）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#1B2229&gt;常规方式（比如常用的 openpyxl 库）会漏掉三样东西：①图形里的文字——流程图方框、箭头旁边的说明文字，图形本身不算文字，容易被忽略；②箭头到底指向哪一边——画的时候先点哪个框，和箭头最终指向哪边是两回事，容易搞反，实测就出过一张图方向记反了，靠检查线条画的箭头在哪一头才发现并修正；③日文汉字上标的读音假名——比如「工番（こうばん）」，处理不当读音会混进正文，变成「工番こうばん」。&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6E7A;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="76" width="1580" height="106" as="geometry" />
        </mxCell>
        <mxCell id="ic_d1a" value="" style="shape=mxgraph.ios7.icons.document;html=1;strokeColor=#2E6E7A;fillColor=none;strokeWidth=1.4;" vertex="1" parent="doclane">
          <mxGeometry x="72" y="99" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="d1b" value="&lt;b&gt;每张 sheet 双份产出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#1B2229&gt;每张 sheet 生成两个文件——一张图片（PNG，长什么样，供人和 AI 看版式）+ 一段文字（TXT，写了什么，供机器处理）。文字里每个值都标上它在哪一列，比如「第10行 A列=4，D列=工番」——方眼纸类表格空列很多，不标列号的话 AI 容易把不同列的值张冠李戴、对错行。隐藏的 sheet 也照样处理，先打上「隐藏」标记，但不在这一步删除——是不是草稿、要不要用，留到下一步统一判断。&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="198" width="1580" height="116" as="geometry" />
        </mxCell>
        <mxCell id="ic_d1b" value="" style="shape=mxgraph.ios7.icons.storage;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.4;" vertex="1" parent="doclane">
          <mxGeometry x="72" y="221" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="e_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" edge="1" parent="doclane" source="d1a" target="d1b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d_sub2" value="区块 2 · 索引 + 台账构建（build.py 依次跑 ①②③，同一份 TXT 分两条独立路径消费）" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="322" width="1000" height="26" as="geometry" />
        </mxCell>

        <mxCell id="sub2a_label" value="① 索引摘要（indexer.py，花钱这一步）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#8A6A2E;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="354" width="500" height="22" as="geometry" />
        </mxCell>

        <mxCell id="d2_filter" value="筛选：剔除隐藏 sheet&#xa;（草稿 / 旧版本，不是交付物）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="384" width="560" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e_d1b_filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="d1b" target="d2_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d2_classify" value="&lt;b&gt;免费分类&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;不问 AI，靠形状 / 命名特征瞬间判断&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ 表格类 / 图类 / 空 / 履历等&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="468" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ic_d2_classify" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.4;" vertex="1" parent="doclane">
          <mxGeometry x="72" y="490" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="e_filter_classify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" edge="1" parent="doclane" source="d2_filter" target="d2_classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="pathA" value="&lt;b&gt;路径 A · 机械抄&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#3E6B63&gt;表格类走这条：表头列位置固定 → 按列一行行抄&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;100% 准确 · 0 费用&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=#5B6169&gt;实测：AI 抄同一张表有时 26 个字段有时只 2 个，机械抄永远 26 个——表格绝不给 AI&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="30" y="588" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_pathA" value="" style="shape=mxgraph.ios7.icons.tools;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="doclane">
          <mxGeometry x="42" y="612" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="pathB" value="&lt;b&gt;路径 B · AI 读懂&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A6A2E&gt;非空的非表格 sheet（图 / 叙述类）走这条&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;是图 → 连图片一起给 AI；是表格 → 只给文字不给图片&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=#5B6169&gt;实测给图反而更差：12 个字段掉到 1 个（AI 看图说话，不逐行读字）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=#5B6169&gt;问 5 件事：写了什么 / 属于哪个系统 / 有哪些识别子 / 能答什么问题 / 哪里看不懂&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="340" y="588" width="290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_pathB" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#8A6A2E;fillColor=none;strokeWidth=1.5;" vertex="1" parent="doclane">
          <mxGeometry x="352" y="612" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_classify_pathA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="d2_classify" target="pathA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_classify_pathB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="d2_classify" target="pathB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="merge" value="合并结果" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="180" y="792" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e_pathA_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="doclane" source="pathA" target="merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pathB_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="doclane" source="pathB" target="merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="out1" value="&lt;b&gt;index.sqlite&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;可检索数据库&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=30;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="884" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ic_out1" value="" style="shape=mxgraph.ios7.icons.storage;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.3;" vertex="1" parent="doclane">
          <mxGeometry x="70" y="905" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="out2" value="&lt;b&gt;OVERVIEW.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;全局地图&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="270" y="884" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="out3" value="&lt;b&gt;REVIEW.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#9C3B2C&gt;要确认清单（人工介入）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF3F0;strokeColor=#9C3B2C;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=30;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="480" y="884" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ic_out3" value="" style="shape=mxgraph.ios7.icons.flag;html=1;strokeColor=#9C3B2C;fillColor=none;strokeWidth=1.3;" vertex="1" parent="doclane">
          <mxGeometry x="490" y="905" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="out4" value="&lt;b&gt;TEMPLATES.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;模板发现报告&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="690" y="884" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="out5" value="&lt;b&gt;md/*.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;每张纸可读版&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="900" y="884" width="190" height="64" as="geometry" />
        </mxCell>
        <mxCell id="e_merge_out1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="merge" target="out1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_merge_out2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="merge" target="out2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_merge_out3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="merge" target="out3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_merge_out4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.6;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="merge" target="out4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_merge_out5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="doclane" source="merge" target="out5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ ② 台账构建（ledger.py） ============ -->
        <mxCell id="sub2b_label" value="② 台账构建（ledger.py，免费这一步，规则驱动，不掺 LLM）——与①并行消费同一份 TXT" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#3E6B63;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="984" width="900" height="22" as="geometry" />
        </mxCell>

        <mxCell id="ledger_input" value="&lt;b&gt;输入&lt;/b&gt;：reader.py 解析出的表格结构（表头 / 表头上方区域 / 表体）+&lt;br&gt;config/extractors/*.json 里定义的抽取器规则" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
          <mxGeometry x="60" y="1016" width="560" height="76" as="geometry" />
        </mxCell>
        <mxCell id="ic_ledger_input" value="" style="shape=mxgraph.ios7.icons.document;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.4;" vertex="1" parent="doclane">
          <mxGeometry x="72" y="1040" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="e_d1b_ledger_input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="doclane" source="d1b" target="ledger_input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="256" />
              <mxPoint x="20" y="1054" />
            </Array>
          </mxGeometry>
        </mxCell>

