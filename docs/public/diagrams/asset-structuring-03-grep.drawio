        <mxCell id="infer_block" value="&lt;b&gt;两段推断&lt;/b&gt;&lt;font style=&quot;font-size:10px&quot; color=#8A6A2E&gt;（source=inferred）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;① learn_prefixes：自动学习画面控件命名前缀（去掉后是否更命中DB列名来验证，不写死配置）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;② infer_links：物理名一致→确度高／日语名一致→确度中&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="doclane">
