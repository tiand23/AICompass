<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="QA-3-grep-harness-memory">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="QA-3 · 以 grep 为核心 + harness（带记忆层）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry" />
        </mxCell>

        <mxCell id="intro" value="这是「资产结构化 · 方案三」里 harness 循环机制的通用化版本——把它从资产结构化场景的一个子区块，提升为独立的 QA agent 架构：LLM 只负责决定查什么、什么时候够了，真正执行查询的是下面的工具（grep / 台账 / resolve 等，工具本身没有 AI）。这版新增了完整的记忆层。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1650" height="46" as="geometry" />
        </mxCell>

        <!-- ===================== MEMORY LAYER ===================== -->
        <mxCell id="mem_title" value="记忆层（会话内 + 跨会话持久 —— 后者为设计延伸）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="108" width="700" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_session" value="&lt;b&gt;会话内记忆&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#3E6B63&gt;已验证实现&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;对话历史（history），进程内存，最近 12 轮，随会话结束而消失——DesignDocAsk 现有真实机制&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_session" value="" style="shape=mxgraph.ios7.icons.message;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="772" y="184" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_query" value="&lt;b&gt;① 查询记忆库&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;按 user_id / project_id 取历史对话 + 已解析实体/结论&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_query" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1132" y="184" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_calibrate" value="&lt;b&gt;② 分层校准&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#3E6B63&gt;强模型全量 / 弱模型精选 / 接近上限跳过&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="140" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_calibrate" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1432" y="184" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_execute" value="&lt;b&gt;③ 任务执行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;指向下方主流程（harness 循环）&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="280" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="mem_write" value="&lt;b&gt;④ 写入声明&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#3E6B63&gt;非覆盖式追加 + 版本化&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;本轮问答 + 工具调用轨迹 + 引用证据&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1120" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_write" value="" style="shape=mxgraph.ios7.icons.flag;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1132" y="324" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mem_query" target="mem_calibrate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mem_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mem_calibrate" target="mem_execute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mem_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="mem_execute" target="mem_write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mem_loop" value="下次读取前核验版本 → 过期标记「存疑」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.2;strokeColor=#3E6B63;fontColor=#3E6B63;endArrow=open;endFill=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#FFFFFF;fontSize=10.5;" edge="1" parent="1" source="mem_write" target="mem_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="mem_caveat" value="&lt;b&gt;⚠ 设计延伸&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;①②③④ 跨会话持久记忆是在已验证实现基础上的设计延伸，DesignDocAsk 当前尚未实现——只有左侧「会话内记忆」是已验证的真实机制。&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FDF3F0;strokeColor=#9C3B2C;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="940" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mem_e_session_q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="mem_session" target="q_input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="792" y="255" />
              <mxPoint x="700" y="255" />
              <mxPoint x="700" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="mem_e_exec_q" value="读取①②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#3E6B63;fontColor=#3E6B63;fontSize=10.5;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mem_execute" target="q_input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1720" y="325" />
              <mxPoint x="1720" y="466" />
              <mxPoint x="340" y="466" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== MAIN FLOW · HARNESS LOOP ===================== -->
        <mxCell id="main_title" value="问答主流程（harness 循环）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="q_input" value="&lt;b&gt;用户提问&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;+ 会话内历史 + 校准后的跨会话记忆上下文&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="420" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ic_q_input" value="" style="shape=mxgraph.ios7.icons.message;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="362" y="446" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_input_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" edge="1" parent="1" source="q_input" target="llm_judge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="llm_judge" value="&lt;b&gt;LLM 判断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;材料够了吗？还要不要继续查？&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="310" y="524" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="call_tool" value="&lt;b&gt;调用一个工具&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;找 / 确认 / 辅助三类里选一个（见下）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="550" width="280" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_call" value="继续查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;fontColor=#5B6169;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="llm_judge" target="call_tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="get_result" value="&lt;b&gt;拿到结果&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;纯规则返回的 JSON——这一步没有 LLM 参与&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#9C3B2C&gt;失败（超时/连接失败/参数错误）同样返回给 LLM 判断，不静默丢失，计入调用预算&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="654" width="280" height="122" as="geometry" />
        </mxCell>
        <mxCell id="e_call_result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call_tool" target="get_result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_result_loop" value="循环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#8A6A2E;fontColor=#8A6A2E;fontSize=10;endArrow=open;endFill=0;exitX=0;exitY=0.15;entryX=1;entryY=0.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="get_result" target="llm_judge">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="668" />
              <mxPoint x="680" y="608" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="final_answer" value="&lt;b&gt;生成最终回答&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;附出典；标注哪些明写、哪些是推断、哪些没查到写「未确认」&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="310" y="694" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_final" value="够了 / 到预算上限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;fontColor=#5B6169;fontSize=10;endArrow=open;endFill=0;" edge="1" parent="1" source="llm_judge" target="final_answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="budget_note" value="&lt;b&gt;预算保护&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;最多循环 12 轮／调用 24 次工具。快到上限时提示 LLM「这是最后机会，只能用已有材料回答，查不到的地方必须写未确认」。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#9C3B2C&gt;失败的调用同样计数，避免对同一个失败工具无限重试。&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F96;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=11;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="650" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e_call_budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1;strokeColor=#8A8F96;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="call_tool" target="budget_note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_final_write" value="写入④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#3E6B63;fontColor=#3E6B63;fontSize=10.5;endArrow=open;endFill=0;exitX=1;exitY=0.3;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="final_answer" target="mem_write">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="705" y="724" />
              <mxPoint x="705" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== TOOL GROUPS ===================== -->
        <mxCell id="grp_find" value="&lt;b&gt;找（第一手）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;grep&lt;/b&gt;：全文机械检索，不排序不截断，找东西的第一手&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;list_objects&lt;/b&gt;：全体目录，不知道去哪找先看目录&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（其余工具见方案三详细版）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="100" y="830" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_find" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="112" y="854" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="grp_confirm" value="&lt;b&gt;确认&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;impact_of&lt;/b&gt;：多跳影响范围（区分明写/推断），自动兜底 grep 补漏&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;get_table / get_sheet&lt;/b&gt;：拿完整定义/原文，给出处用&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（其余工具见方案三详细版）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26415C;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="830" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_confirm" value="" style="shape=mxgraph.ios7.icons.documents;html=1;strokeColor=#26415C;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="854" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="grp_assist" value="&lt;b&gt;辅助&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;resolve&lt;/b&gt;：人话→标识符翻译，&lt;font color=#9C3B2C&gt;查不到就给候选，绝不瞎猜&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;search_docs&lt;/b&gt;：语义检索，只在前两类都找不到时兜底&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（其余工具见方案三详细版）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1080" y="830" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_assist" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#8A6A2E;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1092" y="854" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_agent_find" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0;exitY=0.7;entryX=0.3;entryY=0;" edge="1" parent="1" source="call_tool" target="grp_find">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="810" />
              <mxPoint x="229" y="810" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_agent_confirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call_tool" target="grp_confirm">
