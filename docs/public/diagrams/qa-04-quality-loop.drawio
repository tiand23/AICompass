<mxfile host="drawio" version="26.0.0">
  <diagram name="QA-4质量闭环">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="QA-4 · 质量闭环（会话检索状态 · 索引新鲜度 · 评估反馈）" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="note" value="本图是 QA-1/2/3 任选一种检索架构后共用的质量保障层，不是第四种竞争方案。解决三个共性缺口：多轮追问要不要复用上一轮检索结果、索引内容过期了怎么发现、回答质量差怎么被发现并改进。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6D3C8;dashed=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1560" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== COLUMN A · 会话内检索状态 ===================== -->
        <mxCell id="a_title" value="A · 会话内检索状态（短期，区别于记忆层的跨会话长期记忆）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#26415C;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a_r1" value="本轮检索结果&#xa;本轮命中的具体内容 + 来源检索方式" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a_r2" value="会话检索状态&#xa;当前对话专属的滚动缓存，不是记忆层 user_id/project_id 的持久记忆；会话结束不保留（或可选择性提炼进长期记忆）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26415C;strokeWidth=1.6;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ic_a_r2" value="" style="shape=mxgraph.ios7.icons.cube;html=1;strokeColor=#26415C;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="52" y="303" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="a_dec" value="下一轮追问 · 话题是否延续？&#xa;（比如追问同一个实体/文档）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26415C;strokeWidth=1.6;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
