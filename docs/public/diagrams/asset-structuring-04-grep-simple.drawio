        </mxCell>

        <mxCell id="p4_q2" value="AI 判断&#xa;还要继续查吗？查哪个？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="495" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p4_q3" value="&lt;b&gt;工具执行&lt;/b&gt;&lt;br&gt;&lt;font color=#3E6B63 style=&quot;font-size:11px&quot;&gt;纯规则查询，没有 AI：全文检索(grep) / 查台账(定义·影响范围) / 语义检索(兜底)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
