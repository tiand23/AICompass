        <mxCell id="ic_p4_q3" value="" style="shape=mxgraph.ios7.icons.tools;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="622" y="573" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p4_q4" value="&lt;b&gt;拿到结果&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;原样返回，交给 AI 判断下一步&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="970" y="510" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p4_q5" value="&lt;b&gt;生成回答&lt;/b&gt;&lt;br&gt;&lt;font color=#8A6A2E style=&quot;font-size:11px&quot;&gt;材料够了 / 到预算上限&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.4;align=left;verticalAlign=middle;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="700" width="240" height="90" as="geometry" />
