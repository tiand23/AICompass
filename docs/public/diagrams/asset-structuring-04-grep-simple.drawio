<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="方案四·以grep为中心（简明版）">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="850" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p4_title" value="方案四 · 以 grep 为中心（简明版）" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="28" as="geometry" />
        </mxCell>

        <mxCell id="p4_pos" value="&lt;b&gt;方案定位&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;这是方案三（详细版）的精简版，用于向客户讲解核心思路：索引负责&amp;quot;找到相关文档&amp;quot;，台账负责&amp;quot;精确查询业务对象与关系&amp;quot;；问答时 AI 只决定查什么、什么时候够，真正执行查询的是工具本身——工具里没有 AI。两段推断、健康检查、corrections 表、完整 10 个工具等实现细节，见方案三（详细版）。&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F96;dashed=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1180" y="20" width="460" height="210" as="geometry" />
        </mxCell>

        <!-- ===================== 构建阶段 ===================== -->
        <mxCell id="p4_n1" value="&lt;b&gt;原始资产&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;Excel 设计书等&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_p4_n1" value="" style="shape=mxgraph.ios7.icons.document;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="52" y="193" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p4_n2" value="&lt;b&gt;机械转换&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;每张 sheet/页 → 一张图 + 一段文字&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_p4_n2" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="312" y="193" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p4_n3a" value="&lt;b&gt;索引&lt;/b&gt;&lt;br&gt;&lt;font color=#8A6A2E style=&quot;font-size:11px&quot;&gt;AI 参与：快速浏览、打标题 + 摘要，回答&amp;quot;这是什么、写了什么&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="620" y="90" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ic_p4_n3a" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#8A6A2E;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="632" y="148" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p4_n3b" value="&lt;b&gt;台账&lt;/b&gt;&lt;br&gt;&lt;font color=#3E6B63 style=&quot;font-size:11px&quot;&gt;机械规则抽取，无 AI 参与：把表 / 字段 / 画面 / 程序抽成清单；关系区分&amp;quot;设计书明写&amp;quot;和&amp;quot;按规则推断&amp;quot;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="620" y="250" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ic_p4_n3b" value="" style="shape=mxgraph.ios7.icons.storage;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="632" y="313" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p4_note1" value="另有可选的语义检索作为兜底，这里从略——详见方案三（详细版）" style="text;html=1;fontSize=11;fontColor=#5B6169;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="930" y="300" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p4_section" value="问答阶段 —— AI 只决定查什么，真正执行查询的是工具" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#26415C;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="458" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== 问答（harness 循环）===================== -->
        <mxCell id="p4_q1" value="&lt;b&gt;用户提问&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
