<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="方案二·全体图谱化">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="方案二 · 全体图谱化（Ontology 驱动）" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="核心特点：先设计本体（Ontology），所有抽取都服从这个 schema，最终统一收敛成一张知识图谱 —— 不像方案一那样并行输出多种独立索引" style="text;html=1;fontSize=12;fontColor=#5B6169;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1100" height="24" as="geometry" />
        </mxCell>

        <!-- Row 1: main pipeline -->
        <mxCell id="n1" value="&lt;b&gt;原始资产&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;Office 文本 / PDF / 图片 / 扫描件&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_n1" value="" style="shape=mxgraph.ios7.icons.document;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="92" y="273" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="扫描 &amp; 类型判断&#xa;纯文本 / 复杂表格 / 流程图 / 图片" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="&lt;b&gt;文字抽取 + page/sheet → PNG&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;非结构化内容（图 / 复杂表格）由 VLM 识别生成文本&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="240" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_n3" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="692" y="273" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;metaData 登录&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;来源 / 页码·sheet号 / 类型&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
