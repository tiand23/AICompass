        <mxCell id="e_n4_hero" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;orthogonalLoop=1;jettySize=auto;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="n4" target="hero">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1180" y="410" />
              <mxPoint x="844" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Decision -->
        <mxCell id="gate" value="置信度判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF3F0;strokeColor=#9C3B2C;strokeWidth=1.8;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590" y="660" width="220" height="110" as="geometry" />
