        <mxCell id="leg4t" value="低置信度 · 待人工审核" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="142" width="220" height="22" as="geometry" />
