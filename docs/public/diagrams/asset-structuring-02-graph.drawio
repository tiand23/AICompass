          <mxGeometry x="474" y="486" width="26" height="26" as="geometry" />
        </mxCell>

        <mxCell id="e_ontology_hero" value="约束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.4;strokeColor=#5B4C8A;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#5B4C8A;" edge="1" parent="1" source="ontology" target="hero">
