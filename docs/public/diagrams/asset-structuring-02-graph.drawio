          <mxGeometry x="772" y="863" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_gate_review" value="低 / 不确定" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.4;strokeColor=#9C3B2C;fontColor=#9C3B2C;endArrow=open;endFill=0;exitX=0.25;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="gate" target="review">
