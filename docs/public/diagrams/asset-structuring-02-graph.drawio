        </mxCell>
        <mxCell id="leg6t" value="与方案一相比，AI 角色收窄为&quot;服从本体做抽取&quot;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="legend">
          <mxGeometry x="50" y="200" width="220" height="34" as="geometry" />
        </mxCell>

        <!-- Positioning note -->
        <mxCell id="note" value="&lt;b&gt;方案定位&lt;/b&gt;&lt;br&gt;本方案假定资产的实体关系可以被一套统一 schema 覆盖，前置本体设计投入较高，但产出是一张结构一致、可推理的知识图谱，而非多个独立索引。适合资产结构相对规整、业务概念可预先建模的场景；和方案一相比，AI 的角色从&quot;并行处理一环&quot;收窄为&quot;服从本体做抽取&quot;，精度依赖本体设计质量和人工审核环节。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#D6D3C8;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="1010" width="1560" height="100" as="geometry" />
        </mxCell>

