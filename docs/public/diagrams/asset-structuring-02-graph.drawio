        <!-- Branches -->
        <mxCell id="review" value="&lt;b&gt;人工审核队列&lt;/b&gt;&lt;br&gt;&lt;font color=#9C3B2C style=&quot;font-size:11px&quot;&gt;置信度低 / 抽取不确定&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDF3F0;strokeColor=#9C3B2C;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
