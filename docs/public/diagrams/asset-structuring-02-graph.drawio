        </mxCell>
        <mxCell id="ic_ontology" value="" style="shape=mxgraph.ios7.icons.link;html=1;strokeColor=#5B4C8A;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="92" y="483" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="hero" value="&lt;b&gt;实体 &amp; 关系抽取（Harness）&lt;/b&gt;&lt;br&gt;&lt;font color=#5B4C8A style=&quot;font-size:11.5px&quot;&gt;输入：本体 schema + metaData + 抽取文本&lt;/font&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:10.5px&quot;&gt;按本体定义的实体类型 / 关系类型做抽取（LLM / 规则 harness）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B4C8A;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=40;fontSize=14;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
