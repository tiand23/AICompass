        <mxCell id="graphdb" value="&lt;b&gt;知识图谱就绪&lt;/b&gt;&lt;br&gt;&lt;font color=#2E6E7A style=&quot;font-size:11px&quot;&gt;Graph DB&lt;/font&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:10.5px&quot;&gt;全部资产实体化 · 关系化 · 供下游多跳查询 / 问答使用&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6E7A;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
