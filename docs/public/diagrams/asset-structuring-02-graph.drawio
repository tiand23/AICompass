          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Row 2: ontology + hero extraction -->
        <mxCell id="ontology" value="&lt;b&gt;设计资产领域本体&lt;/b&gt;&lt;br&gt;&lt;font color=#5B4C8A style=&quot;font-size:11px&quot;&gt;Ontology：实体类型 + 关系类型 schema&lt;/font&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:10.5px&quot;&gt;人工设计 · 可迭代 · 是后续抽取的&quot;标准答案模板&quot;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B4C8A;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
