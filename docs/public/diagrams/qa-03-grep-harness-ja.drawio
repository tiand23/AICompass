              <mxPoint x="1720" y="325" />
              <mxPoint x="1720" y="466" />
              <mxPoint x="340" y="466" />
            </Array>
          </mxGeometry>
        </mxCell>

        
        <mxCell id="main_title" value="質問応答メインフロー（harness ループ）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="q_input" value="&lt;b&gt;ユーザーの質問&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;+ セッション内履歴 + 較正済みのセッション横断記憶コンテキスト&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="420" width="340" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ic_q_input" value="" style="shape=mxgraph.ios7.icons.message;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="362" y="446" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_input_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" edge="1" parent="1" source="q_input" target="llm_judge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="llm_judge" value="&lt;b&gt;LLM の判断&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;材料は揃ったか？さらに調べる必要があるか？&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="310" y="524" width="320" height="140" as="geometry" />
        </mxCell>

        <mxCell id="call_tool" value="&lt;b&gt;ツールを1つ呼び出す&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;見つける / 確かめる / 補助の3種から1つ選ぶ（下記参照）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="550" width="280" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_call" value="継続調査" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;fontColor=#5B6169;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" edge="1" parent="1" source="llm_judge" target="call_tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="get_result" value="&lt;b&gt;結果を受け取る&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;純粋なルールが返す JSON——このステップに LLM は関与しない&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#9C3B2C&gt;失敗（タイムアウト/接続失敗/パラメータエラー）も同様に LLM の判断へ返し、黙って失われることはなく、呼び出し予算にカウントされる&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="654" width="280" height="122" as="geometry" />
        </mxCell>
        <mxCell id="e_call_result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="call_tool" target="get_result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_result_loop" value="ループ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#8A6A2E;fontColor=#8A6A2E;fontSize=10;endArrow=open;endFill=0;exitX=0;exitY=0.15;entryX=1;entryY=0.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="get_result" target="llm_judge">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="668" />
              <mxPoint x="680" y="608" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="final_answer" value="&lt;b&gt;最終回答を生成&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;出典を添付；明記／推論／「未確認」（見つからなかった箇所）を区別して明示&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="310" y="694" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_final" value="十分 / 予算上限に到達" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;fontColor=#5B6169;fontSize=10;endArrow=open;endFill=0;" edge="1" parent="1" source="llm_judge" target="final_answer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="budget_note" value="&lt;b&gt;予算保護&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#5B6169&gt;最大 12 ループ／ツール呼び出し 24 回まで。上限に近づくと LLM に「これが最後の機会、既存の材料だけで回答し、分からない箇所は必ず未確認と明記する」よう提示。&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=#9C3B2C&gt;失敗した呼び出しも同様にカウントし、同じ失敗ツールへの無限リトライを防ぐ。&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F96;strokeWidth=1;align=left;verticalAlign=middle;spacingLeft=16;fontSize=11;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="650" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e_call_budget" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1;strokeColor=#8A8F96;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="call_tool" target="budget_note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_final_write" value="④へ書き込み" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#3E6B63;fontColor=#3E6B63;fontSize=10.5;endArrow=open;endFill=0;exitX=1;exitY=0.3;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="final_answer" target="mem_write">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="705" y="724" />
              <mxPoint x="705" y="325" />
            </Array>
          </mxGeometry>
        </mxCell>

        
        <mxCell id="grp_find" value="&lt;b&gt;見つける（第一手）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;grep&lt;/b&gt;：原文をそのまま探す、並べ替えも打ち切りもしない、探し物の第一手&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;list_objects&lt;/b&gt;：全体目録、どこを探せばよいか分からない時はまず目録を見る&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（その他のツールは方式3詳細版を参照）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="100" y="830" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_find" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="112" y="854" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="grp_confirm" value="&lt;b&gt;確かめる&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;impact_of&lt;/b&gt;：多段階の影響範囲（明記/推論を区別）、自動的に grep で補完&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;get_table / get_sheet&lt;/b&gt;：完全な定義/原文を取得、出典に使う&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（その他のツールは方式3詳細版を参照）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26415C;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="830" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_confirm" value="" style="shape=mxgraph.ios7.icons.documents;html=1;strokeColor=#26415C;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="854" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="grp_assist" value="&lt;b&gt;補助&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;resolve&lt;/b&gt;：人の言葉→識別子への翻訳、&lt;font color=#9C3B2C&gt;見つからなければ候補を提示、絶対に当て推量しない&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;search_docs&lt;/b&gt;：意味検索、前の2種でも見つからない時の最後の手段&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（その他のツールは方式3詳細版を参照）&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1080" y="830" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ic_grp_assist" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#8A6A2E;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1092" y="854" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e_agent_find" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0;exitY=0.7;entryX=0.3;entryY=0;" edge="1" parent="1" source="call_tool" target="grp_find">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="810" />
              <mxPoint x="229" y="810" />
            </Array>
