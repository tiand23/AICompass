<mxfile host="drawio" version="26.0.0">
  <diagram name="QA-3-grep-harness-memory">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        
        <mxCell id="title" value="QA-3・grep を中心に + harness（記憶層付き）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="32" as="geometry" />
        </mxCell>

        <mxCell id="intro" value="これは「資産構造化・方式3」の harness ループ機構を汎用化したバージョンです——資産構造化シナリオの一区分から、独立した QA agent アーキテクチャへと昇格させました：LLM は何を調べるか・いつ十分かを決定するだけで、実際にクエリを実行するのは下記のツール（grep／台帳／resolve など、ツール自体には AI が含まれない）です。このバージョンでは完全な記憶層が新たに追加されています。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1650" height="46" as="geometry" />
        </mxCell>

        
        <mxCell id="mem_title" value="記憶層（セッション内 + セッション横断の永続記憶 —— 後者は設計上の拡張）" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="108" width="700" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_session" value="&lt;b&gt;セッション内記憶&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#3E6B63&gt;実装済み&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;対話履歴（history）、プロセスメモリ、直近12ターン、セッション終了とともに消失——DesignDocAsk の現行の実機制&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_session" value="" style="shape=mxgraph.ios7.icons.message;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="772" y="184" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_query" value="&lt;b&gt;① 記憶ストアを検索&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;user_id / project_id 単位で履歴対話 + 解析済みの実体/結論を取得&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_query" value="" style="shape=mxgraph.ios7.icons.looking_glass;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1132" y="184" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_calibrate" value="&lt;b&gt;② 階層的較正&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#3E6B63&gt;強モデルは全量 / 弱モデルは厳選 / 上限に近ければ対象外&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="140" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_calibrate" value="" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1432" y="184" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_execute" value="&lt;b&gt;③ タスク実行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;下方のメインフロー（harness ループ）へ接続&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1420" y="280" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="mem_write" value="&lt;b&gt;④ 主張を書き込み&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#3E6B63&gt;上書きせず追記 + バージョン管理&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;今回の質問応答 + ツール呼び出し軌跡 + 引用根拠&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1120" y="280" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ic_mem_write" value="" style="shape=mxgraph.ios7.icons.flag;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1132" y="324" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="mem_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mem_query" target="mem_calibrate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mem_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mem_calibrate" target="mem_execute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mem_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="mem_execute" target="mem_write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mem_loop" value="次回読み取り前にバージョンを検証 → 期限切れは「要確認」に" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.2;strokeColor=#3E6B63;fontColor=#3E6B63;endArrow=open;endFill=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;labelBackgroundColor=#FFFFFF;fontSize=10.5;" edge="1" parent="1" source="mem_write" target="mem_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="mem_caveat" value="&lt;b&gt;⚠ 設計上の拡張&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;①②③④ のセッション横断の永続記憶は、実装済みの機能を基にした設計上の拡張であり、DesignDocAsk では現時点で未実装——左側の「セッション内記憶」のみが実装済みの実機制です。&lt;/font&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FDF3F0;strokeColor=#9C3B2C;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="380" width="940" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mem_e_session_q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.1;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="mem_session" target="q_input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="792" y="255" />
              <mxPoint x="700" y="255" />
              <mxPoint x="700" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="mem_e_exec_q" value="①②を読み取り" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeWidth=1.3;strokeColor=#3E6B63;fontColor=#3E6B63;fontSize=10.5;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mem_execute" target="q_input">
