  <diagram name="方案四·以grep为中心（简明版）" id="0">
    <mxGraphModel dx="1628" dy="1048" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="850" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="方案四 · 以 grep 为中心（简明版）" vertex="1">
          <mxGeometry height="28" width="760" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p4_pos" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F96;dashed=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" value="&lt;b&gt;方案定位&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;这是方案三（详细版）的精简版，用于向客户讲解核心思路：索引负责&amp;quot;找到相关文档&amp;quot;，台账负责&amp;quot;精确查询业务对象与关系&amp;quot;；问答时 AI 只决定查什么、什么时候够，真正执行查询的是工具本身——工具里没有 AI。两段推断、健康检查、corrections 表、完整 10 个工具等实现细节，见方案三（详细版）。&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="460" x="1180" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p4_n1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;原始资产&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;Excel 设计书等&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="200" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="ic_p4_n1" parent="1" style="shape=mxgraph.ios7.icons.document;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" value="" vertex="1">
