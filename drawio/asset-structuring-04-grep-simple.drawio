        </mxCell>
        <mxCell id="p4_n2" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;机械转换&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;每张 sheet/页 → 一张图 + 一段文字&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="300" y="160" as="geometry" />
