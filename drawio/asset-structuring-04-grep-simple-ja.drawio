        </mxCell>

        <mxCell id="p4_q2" value="AI の判断&#10;さらに調べるか？何を調べるか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="495" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p4_q3" value="&lt;b&gt;ツール実行&lt;/b&gt;&lt;br&gt;&lt;font color=#3E6B63 style=&quot;font-size:11px&quot;&gt;純粋なルールクエリ、AI 不使用：全文検索(grep) / 台帳照会(定義・影響範囲) / 意味検索(フォールバック)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="610" y="510" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ic_p4_q3" value="" style="shape=mxgraph.ios7.icons.tools;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="622" y="573" width="22" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p4_q4" value="&lt;b&gt;結果を取得&lt;/b&gt;&lt;br&gt;&lt;font color=#5B6169 style=&quot;font-size:11px&quot;&gt;そのまま返し、次の判断は AI に委ねる&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="970" y="510" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p4_q5" value="&lt;b&gt;回答を生成&lt;/b&gt;&lt;br&gt;&lt;font color=#8A6A2E style=&quot;font-size:11px&quot;&gt;材料が揃った / 予算上限に到達&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.4;align=left;verticalAlign=middle;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" vertex="1" parent="1">
