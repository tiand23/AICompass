        <mxCell id="e_judge_call" edge="1" parent="1" source="llm_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;fontColor=#5B6169;fontSize=10;endArrow=open;endFill=0;exitX=1;exitY=0.35;entryX=0;entryY=0.5;" target="call_tool" value="調べ続ける">
          <mxGeometry relative="1" as="geometry" />
