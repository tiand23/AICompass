<mxfile host="Electron">
  <diagram name="資産構造化-方式3-grep中心型" id="0">
    <mxGraphModel dx="1245" dy="801" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="資産構造化 ・ 方式3：grep中心型（工程1→2→3 の実装に基づく）" vertex="1">
          <mxGeometry height="32" width="1100" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="ph1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=44;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;精度はツールから生まれる。AIからではない&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;機械的抽出を優先：ルール／列位置／構文木で抽出できる内容は一律 AI に聞かない（コスト0・100%正確・再現可能）。AI は機械にできないことだけを担当——図を読む、文章を読む、要約を書く。表形式の内容は絶対に AI に転記させない：実測では同じ表を AI に読ませると 26 項目のときも 2 項目のときもあったが、機械的な転記は常に 26 項目。&lt;br&gt;台帳構築（下記②）は完全に&lt;b&gt;ルール駆動&lt;/b&gt;（config の extractor 定義）で、LLM は一切介在しない。AI が登場するのは「要約」（下記①）の工程だけ——AI が得意なことをやらせている。&lt;/font&gt;" vertex="1">
          <mxGeometry height="112" width="1650" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="ic_ph1" parent="1" style="shape=mxgraph.ios7.icons.flag;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.6;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="58" y="106" as="geometry" />
        </mxCell>
        <mxCell id="in1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;元データ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;Excel 設計書（工程1 ExcelSheetToPngText の入力）&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="680" y="204" as="geometry" />
        </mxCell>
        <mxCell id="ic_in1" parent="1" style="shape=mxgraph.ios7.icons.documents;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="692" y="227" as="geometry" />
        </mxCell>
        <mxCell id="e_in_doclane" edge="1" parent="1" source="in1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.34;entryY=0;" target="doclane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="doclane" parent="1" style="swimlane;startSize=32;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E6E7A;fontSize=14;fontStyle=1;verticalAlign=top;fontColor=#2E6E7A;strokeWidth=1.6;fontFamily=Helvetica;swimlaneFillColor=none;" value="ExcelSheetToPngText（工程1）→ DesignDocIndexer（工程2 索引＋工程3 台帳、build.py が一括制御）" vertex="1">
          <mxGeometry height="1860" width="1650" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="d_sub1" parent="doclane" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#2E6E7A;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="エリア1・機械的変換（ExcelSheetToPngText）" vertex="1">
          <mxGeometry height="24" width="500" x="60" y="44" as="geometry" />
        </mxCell>
        <mxCell id="d1a" parent="doclane" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E6E7A;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;Excel 内部ファイルを直接読む&lt;/b&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;（一般的な読み取り方式は使わない）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#1B2229&gt;一般的な方法（よく使われる openpyxl ライブラリなど）では、次の三つが漏れる——①図形の中の文字：フローチャートの枠や矢印の脇にある説明文字は、図形そのものは文字として扱われず見落とされやすい；②矢印がどちら向きか：描くときにどちらの枠を先にクリックしたかと、矢印が最終的にどちらを向くかは別物で、逆になりやすい——実際にある図で向きが逆に記録されていたことがあり、線そのものに描かれた矢印がどちら側にあるかを確認して修正した；③日本語漢字に振られた読み仮名：たとえば「工番（こうばん）」を正しく扱わないと、読み仮名が本文に混ざり「工番こうばん」になってしまう。&lt;/font&gt;" vertex="1">
          <mxGeometry height="106" width="1580" x="60" y="76" as="geometry" />
        </mxCell>
        <mxCell id="ic_d1a" parent="doclane" style="shape=mxgraph.ios7.icons.document;html=1;strokeColor=#2E6E7A;fillColor=none;strokeWidth=1.4;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="72" y="99" as="geometry" />
        </mxCell>
        <mxCell id="d1b" parent="doclane" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;シートごとに二つの成果物&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#1B2229&gt;1枚のシートごとに二つのファイルを生成する——画像1枚（PNG、見た目そのまま。人と AI が版面を見るため）＋テキスト1本（TXT、書かれている内容。機械処理用）。テキスト内の値にはすべて列の位置を付ける、たとえば「10行目 A列=4、D列=工番」——方眼紙形式の表は空列が多く、列番号を付けないと AI が値を別の列と取り違えてしまう。非表示のシートも同様に処理し、まず「非表示」マークだけ付ける。この段階では削除しない——草稿かどうか、使うかどうかの判断は次の工程でまとめて行う。&lt;/font&gt;" vertex="1">
          <mxGeometry height="116" width="1580" x="60" y="198" as="geometry" />
        </mxCell>
        <mxCell id="ic_d1b" parent="doclane" style="shape=mxgraph.ios7.icons.storage;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.4;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="72" y="221" as="geometry" />
        </mxCell>
        <mxCell id="e_d1" edge="1" parent="doclane" source="d1a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" target="d1b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_sub2" parent="doclane" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="エリア2・要約＋台帳構築（build.py が①②③の順に実行、同じ TXT を二つの独立した経路で消費）" vertex="1">
          <mxGeometry height="26" width="1000" x="60" y="322" as="geometry" />
        </mxCell>
        <mxCell id="sub2a_label" parent="doclane" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#8A6A2E;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="① 要約（indexer.py、費用が発生する工程）" vertex="1">
          <mxGeometry height="22" width="500" x="60" y="354" as="geometry" />
        </mxCell>
        <mxCell id="d2_filter" parent="doclane" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="選別：非表示シートを除外&#xa;（草稿／旧版本、成果物ではない）" vertex="1">
          <mxGeometry height="64" width="560" x="60" y="384" as="geometry" />
        </mxCell>
        <mxCell id="e_d1b_filter" edge="1" parent="doclane" source="d1b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" target="d2_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2_classify" parent="doclane" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.6;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;無料の分類&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;AI に聞かず、形状／命名の特徴だけで即座に判断&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;→ 表形式／図／空／履歴 など&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="560" x="60" y="468" as="geometry" />
        </mxCell>
        <mxCell id="ic_d2_classify" parent="doclane" style="shape=mxgraph.ios7.icons.settings;html=1;strokeColor=#1B2229;fillColor=none;strokeWidth=1.4;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="72" y="490" as="geometry" />
        </mxCell>
        <mxCell id="e_filter_classify" edge="1" parent="doclane" source="d2_filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.2;strokeColor=#8A8F96;endArrow=open;endFill=0;" target="d2_classify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pathA" parent="doclane" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E6B63;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;経路A・機械的に転記&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#3E6B63&gt;表形式のシートはこちら：表頭の列位置が固定 → 列ごとに1行ずつ転記&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;100% 正確・コスト0&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=#5B6169&gt;実測：同じ表を AI に転記させると 26 項目のときも 2 項目のときもあったが、機械的な転記は常に 26 項目——表形式は絶対に AI に渡さない&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="30" y="588" as="geometry" />
        </mxCell>
        <mxCell id="ic_pathA" parent="doclane" style="shape=mxgraph.ios7.icons.tools;html=1;strokeColor=#3E6B63;fillColor=none;strokeWidth=1.5;" value="" vertex="1">
          <mxGeometry height="22" width="22" x="42" y="612" as="geometry" />
        </mxCell>
        <mxCell id="pathB" parent="doclane" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2E;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;経路B・AI に読ませる&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A6A2E&gt;空でない非表形式のシート（図／文章系）はこちら&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;図なら画像も一緒に AI に渡す／表なら文字だけ渡して画像は渡さない&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=#5B6169&gt;実測：画像を渡すとかえって悪化——12 項目が 1 項目に減った（AI が図を見て語ってしまい、行ごとに文字を読まなくなる）&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=#5B6169&gt;5つを問う：何が書かれているか／どのシステムか／どんな識別子があるか／どんな質問に答えられるか／どこが読み取れないか&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="290" x="340" y="588" as="geometry" />
        </mxCell>
