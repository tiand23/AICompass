        <mxCell id="call_tool" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=16;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;ツールを1つ呼び出す&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#5B6169&gt;下記10個のツールから1つを選ぶ&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="640" y="2376" as="geometry" />
