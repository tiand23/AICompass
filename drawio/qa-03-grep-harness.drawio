        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="QA-3 · 以 grep 为核心 + harness（带记忆层）" vertex="1">
          <mxGeometry height="32" width="900" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="intro" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5B6169;fontFamily=Helvetica;" value="这是「资产结构化 · 方案三」里 harness 循环机制的通用化版本——把它从资产结构化场景的一个子区块，提升为独立的 QA agent 架构：LLM 只负责决定查什么、什么时候够了，真正执行查询的是下面的工具（grep / 台账 / resolve 等，工具本身没有 AI）。这版新增了完整的记忆层。" vertex="1">
          <mxGeometry height="46" width="1650" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="mem_title" parent="1" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1B2229;align=left;verticalAlign=middle;fontFamily=Helvetica;" value="记忆层（会话内 + 跨会话持久 —— 后者为设计延伸）" vertex="1">
          <mxGeometry height="22" width="700" x="760" y="108" as="geometry" />
        </mxCell>
        <mxCell id="mem_session" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2229;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=34;fontSize=12;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;会话内记忆&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#3E6B63&gt;已验证实现&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=#5B6169&gt;对话历史（history），进程内存，最近 12 轮，随会话结束而消失——DesignDocAsk 现有真实机制&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="320" x="760" y="140" as="geometry" />
        </mxCell>
