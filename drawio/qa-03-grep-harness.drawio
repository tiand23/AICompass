        </mxCell>
        <mxCell id="grp_confirm" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26415C;strokeWidth=1.8;align=left;verticalAlign=middle;spacingLeft=34;fontSize=13;fontColor=#1B2229;fontFamily=Helvetica;" value="&lt;b&gt;确认&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;impact_of&lt;/b&gt;：多跳影响范围（区分明写/推断），自动兜底 grep 补漏&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;get_table / get_sheet&lt;/b&gt;：拿完整定义/原文，给出处用&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot; color=#8A8F96&gt;（其余工具见方案三详细版）&lt;/font&gt;" vertex="1">
