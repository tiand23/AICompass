  <diagram name="QA-3-grep-harness-memory" id="0">
    <mxGraphModel dx="1511" dy="973" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
